{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": false,
    "exactOptionalPropertyTypes": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "bin/**/*.js",
    "cli/**/*.js",
    "server/**/*.js",
    "adapters/**/*.js",
    "core/**/*.js",
    "types.d.ts"
  ],
  "exclude": ["node_modules", "tests"]
}
